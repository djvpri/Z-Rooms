# ─────────────────────────────────────────
# DATABASE (Railway PostgreSQL)
# ─────────────────────────────────────────
# Salin dari Railway dashboard > Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-yang-kuat"
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://nusasewa.up.railway.app"

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NusaSewa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────
# DEMO ENDPOINT (server-to-server: /api/demo/setup, /api/demo/reset-daily)
# ─────────────────────────────────────────
# Tanpa ini kedua endpoint menolak semua request (401).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEMO_SECRET=""
