// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// AUTH
// ───────────────────────────────────────────────
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role       @default(USER)
  faceId        String?    @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  properti      Properti[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  MANAGER
}

// ───────────────────────────────────────────────
// PROPERTI
// ───────────────────────────────────────────────
model Properti {
  id          String        @id @default(cuid())
  nama        String
  tipe        TipeProperti
  alamat      String
  kota        String
  provinsi    String        @default("Kalimantan Barat")
  deskripsi   String?
  fasilitas   String[]      @default([])
  aktif       Boolean       @default(true)
  // Jam acuan habis sewa (HH:mm, jam dinding lokal). Sewa HARIAN habis di jam
  // ini pada hari terakhir, bukan jam masuk + 24 jam — supaya checkout serempak.
  // ToleransiCheckout = menit kelonggaran sebelum ditandai lewat (120 = 2 jam).
  jamCheckout         String  @default("12:00")
  toleransiCheckout   Int     @default(120)
  // Kontak & catatan pemilik properti. Keduanya muncul di nota cetak:
  // noHp di baris kontak, teksNota menggantikan kalimat penutup bawaan.
  // Opsional — properti tanpa isinya tetap memakai teks bawaan.
  noHp        String?
  teksNota    String?
  isDemo      Boolean       @default(false)
  demoExpiresAt DateTime?

  // Lisensi/langganan properti ini. Pola sama dengan Tenant.plan di ZGym:
  // plan = free/basic/pro/business, planExpires = tanggal berakhir (null =
  // belum diatur). TIDAK ada kolom kuota — ZXRoom tak punya padanan
  // maxMembers/maxInstructors/maxClasses, dan kuota yang tak ditegakkan cuma
  // jadi hiasan yang menyesatkan.
  plan        String        @default("free")
  planExpires DateTime?

  // Preferensi tampilan tabel kamar (kolom mana yang tampil & urutannya), JSON
  // teks. Per-PROPERTI, bukan per-user: semua staf properti ini melihat tabel
  // yang sama, jadi tak ada dua kasir dengan tampilan berbeda di meja yang sama.
  // NULL = belum pernah diatur -> halaman memakai urutan bawaan.
  prefTabelKamar String?

  // Setelan cetak nota (ukuran kertas, koneksi, printer terakhir), JSON teks.
  // Per-PROPERTI untuk alasan yang sama dengan prefTabelKamar: satu meja kasir
  // satu printer, dan semua staf properti itu harus mencetak dengan setelan
  // yang sama. NULL = belum diatur -> lib/cetak.ts memakai bawaan.
  prefCetak String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])

  kamar       Kamar[]
  tipeKamar   TipeKamar[]
  fasilitasMaster Fasilitas[]
  produk      Produk[]
  penjualan   Penjualan[]
  ruangKaraoke RuangKaraoke[]
  sesiKaraoke  SesiKaraoke[]
}

enum TipeProperti {
  KOS
  KONTRAKAN
  HOTEL
  APARTEMEN
}

// ───────────────────────────────────────────────
// KAMAR
// ───────────────────────────────────────────────
model Kamar {
  id          String       @id @default(cuid())
  nomor       String
  lantai      Int          @default(1)
  luas        Float?       // m²
  fasilitas   String[]     @default([])
  foto        String[]     @default([])
  status      StatusKamar  @default(TERSEDIA)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Tipe kamar kini master data (model TipeKamar), bukan enum — pemilik bisa
  // menambah tipe sendiri (Studio, Family, ...). WAJIB diisi: harga sewa
  // melekat pada tipe (lihat HargaTipe), jadi kamar tanpa tipe tak bisa
  // dihargai. Baris lama yang null ditautkan ke tipe bawaan saat deploy
  // (lihat scripts/rapikan-tipe-kamar.mjs di start command).
  tipeId      String
  tipe        TipeKamar    @relation(fields: [tipeId], references: [id])

  propertiId  String
  properti    Properti     @relation(fields: [propertiId], references: [id])

  sewa        Sewa[]

  @@unique([propertiId, nomor])
  @@index([tipeId])
}

// Tipe kamar per properti. Fasilitas di sini adalah BAWAAN tipe — kamar yang
// belum diisi fasilitas sendiri mewarisinya. Kamar yang sudah punya fasilitas
// sendiri TIDAK ditimpa, supaya kamar yang berbeda dari tipe-nya tetap aman.
// Harga juga melekat di sini (lihat HargaTipe) — satu tipe, satu daftar harga.
model TipeKamar {
  id          String    @id @default(cuid())
  nama        String
  keterangan  String?
  fasilitas   String[]  @default([])
  urutan      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  propertiId  String
  properti    Properti  @relation(fields: [propertiId], references: [id])

  kamar       Kamar[]
  harga       HargaTipe[]

  @@unique([propertiId, nama])
  @@index([propertiId])
}

// Daftar saran fasilitas milik properti (master data). Sebelumnya saran ini
// hardcoded di lib/tipeKamar.ts (SARAN_FASILITAS), jadi tiap properti terpaksa
// menawarkan daftar yang sama dan ejaannya gampang berbeda-beda ("WiFi" vs
// "Wifi"), yang bikin pencarian/filter meleset.
//
// `TipeKamar.fasilitas` dan `Kamar.fasilitas` TETAP String[] — master ini cuma
// memasok pilihan di form. Fasilitas yang sudah menempel di tipe/kamar tidak
// ikut terhapus kalau barisnya dihapus di sini; UI menandainya "tak ada di
// daftar" supaya pemilik bisa mengurutkan sendiri.
model Fasilitas {
  id          String   @id @default(cuid())
  nama        String
  urutan      Int      @default(0)
  // Nonaktif = tak ditawarkan di form, tapi tetap dipertahankan supaya
  // tipe/kamar yang sudah memakainya tidak berubah tampilannya.
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertiId  String
  properti    Properti @relation(fields: [propertiId], references: [id], onDelete: Cascade)

  @@unique([propertiId, nama])
  @@index([propertiId])
}

enum StatusKamar {
  TERSEDIA
  TERISI
  PEMELIHARAAN
  DIPESAN
}

// Harga sewa melekat pada TIPE kamar, bukan per kamar: mengubah tarif Standar
// cukup satu tempat, bukan 12 kamar satu per satu. Persis pola fasilitas.
model HargaTipe {
  id          String      @id @default(cuid())
  tipeKamarId String
  periodeSewa PeriodeSewa
  harga       Decimal     @db.Decimal(12, 0)
  deposit     Decimal?    @db.Decimal(12, 0)
  aktif       Boolean     @default(true)

  tipeKamar   TipeKamar   @relation(fields: [tipeKamarId], references: [id], onDelete: Cascade)

  @@unique([tipeKamarId, periodeSewa])
  @@index([tipeKamarId])
}

enum PeriodeSewa {
  HARIAN
  MINGGUAN
  BULANAN
  TAHUNAN
}

// ───────────────────────────────────────────────
// PENYEWA
// ───────────────────────────────────────────────
model Penyewa {
  id           String     @id @default(cuid())
  nama         String?
  nik          String?    @unique
  noHp         String?
  email        String?
  pekerjaan    String?
  alamatAsal   String?
  fotoKtp      String?
  tipeEntitas  TipeEntitas @default(INDIVIDU)
  namaPerusahaan String?
  npwp         String?
  // Jejak nama lama, diisi saat nama penyewa diubah: [{nama, digantiPada}].
  // Sewa & Tagihan hanya menyimpan penyewaId, jadi tanpa ini nama di dokumen
  // lama tak bisa dilacak lagi setelah penyewa mengganti namanya.
  riwayatNama  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sewa         Sewa[]
}

enum TipeEntitas {
  INDIVIDU
  PERUSAHAAN
}

// ───────────────────────────────────────────────
// SEWA (kontrak)
// ───────────────────────────────────────────────
model Sewa {
  id           String      @id @default(cuid())
  kamarId      String
  penyewaId    String
  periodeSewa  PeriodeSewa
  tanggalMasuk DateTime
  tanggalKeluar DateTime
  // Diisi saat check-out. Bisa beda dari tanggalKeluar (kontrak) kalau penyewa
  // keluar lebih cepat/lambat — tanpa ini laporan "kamar kosong sejak kapan"
  // ikut tanggal kontrak dan jadi tidak akurat.
  tanggalKeluarAktual DateTime?
  hargaSewa    Decimal     @db.Decimal(12, 0)
  deposit      Decimal     @db.Decimal(12, 0) @default(0)
  statusSewa   StatusSewa  @default(AKTIF)
  metodeBayar  MetodeBayar @default(TUNAI)
  catatan      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  kamar        Kamar       @relation(fields: [kamarId], references: [id])
  penyewa      Penyewa     @relation(fields: [penyewaId], references: [id])
  tagihan      Tagihan[]
  // Penjualan barang titipan ke kamar ini (minuman/makanan). Bisa kosong.
  penjualan    Penjualan[]
}

enum StatusSewa {
  AKTIF
  SELESAI
  DIBATALKAN
  PENDING
}


// ───────────────────────────────────────────────
// TAGIHAN & PEMBAYARAN
// ───────────────────────────────────────────────
model Tagihan {
  id           String         @id @default(cuid())
  sewaId       String
  nominal      Decimal        @db.Decimal(12, 0)
  periodeDari  DateTime
  periodeHingga DateTime
  jatuhTempo   DateTime
  status       StatusTagihan  @default(BELUM_BAYAR)
  catatan      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sewa         Sewa           @relation(fields: [sewaId], references: [id])
  pembayaran   Pembayaran[]
}

enum StatusTagihan {
  BELUM_BAYAR
  SEBAGIAN
  LUNAS
  TERLAMBAT
  DIBATALKAN
}

model Pembayaran {
  id            String        @id @default(cuid())
  tagihanId     String
  nominal       Decimal       @db.Decimal(12, 0)
  metodeBayar   MetodeBayar
  buktiTransfer String?
  catatan       String?
  dibayarPada   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  tagihan       Tagihan       @relation(fields: [tagihanId], references: [id])
}

enum MetodeBayar {
  TUNAI
  TRANSFER
  QRIS
  VA_BCA
  VA_BRI
  VA_MANDIRI
  LAINNYA
}

// ───────────────────────────────────────────────
// PENGELUARAN
// ───────────────────────────────────────────────
model Pengeluaran {
  id          String           @id @default(cuid())
  propertiId  String
  kategori    KategoriBeban
  deskripsi   String
  nominal     Decimal          @db.Decimal(12, 0)
  tanggal     DateTime
  bukti       String?
  createdAt   DateTime         @default(now())

  @@index([propertiId, tanggal])
}

enum KategoriBeban {
  LISTRIK
  AIR
  INTERNET
  KEBERSIHAN
  PERAWATAN
  PAJAK
  GAJI
  LAINNYA
}

// ───────────────────────────────────────────────
// NOTIFIKASI
// ───────────────────────────────────────────────
model Notifikasi {
  id          String           @id @default(cuid())
  propertiId  String
  tipe        TipeNotifikasi
  judul       String
  pesan       String
  dibaca      Boolean          @default(false)
  referensiId String?          // bisa sewaId, tagihanId, dll
  createdAt   DateTime         @default(now())

  @@index([propertiId, dibaca])
}

enum TipeNotifikasi {
  TAGIHAN_JATUH_TEMPO
  TAGIHAN_TERLAMBAT
  PEMBAYARAN_DITERIMA
  CHECKIN_BARU
  CHECKOUT_BESOK
  BOOKING_BARU
  PEMELIHARAAN
  INFO
}

// ───────────────────────────────────────────────
// LOG ERROR (diagnosa remote)
// ───────────────────────────────────────────────
// Log error dari peramban kasir, dikirim lewat tombol di tab Pengaturan.
//
// Bukan audit trail: baris di sini dihapus otomatis setelah 12 jam (lihat
// app/api/log/route.ts). Tujuannya cuma menjawab "apa yang rusak di HP/PC
// kasir tadi" tanpa harus ke sana.
//
// propertiId sengaja TANPA relasi: log harus tetap tersimpan walau properti
// dihapus, dan menghapus properti tak boleh ikut memutus riwayat diagnosa.
// Kalau nanti perlu dirujuk, simpan sebagai String bebas.
model LogKasir {
  id         String   @id @default(cuid())
  propertiId String?
  // Penanda perangkat. ZXRoom berbasis web, jadi "device" = satu peramban:
  // kasir bisa buka dari HP, tablet, atau PC yang sama-sama tak bernama.
  perangkat  String
  // Nama yang diketik kasir (mis. "HP kasir depan"), supaya tahu siapa.
  nama       String?
  konten     String
  createdAt  DateTime @default(now())

  @@index([propertiId, createdAt])
}

// PENJUALAN BARANG (minuman/makanan)
// ───────────────────────────────────────────────
// Jalur uang masuk yang BERDIRI SENDIRI — sengaja TIDAK lewat model Tagihan,
// karena Tagihan.sewaId wajib (selalu milik satu kontrak sewa). Memaksakan
// penjualan masuk ke sana berarti membuat Sewa palsu per botol air.
//
// Dua bentuk penjualan:
//   - sewaId NULL  -> jual lepas (tamu walk-in / staf), status LUNAS.
//   - sewaId diisi -> titipan ke kamar, status BELUM_BAYAR, ikut dilunasi saat
//     check-out (lihat app/api/sewa/[id]/checkout/route.ts blok `lunasi`).
model Produk {
  id          String   @id @default(cuid())
  propertiId  String
  nama        String
  // hargaJual = harga ke penyewa. hargaBeli = HPP (modal), dipakai menghitung
  // laba. Nullable: pemilik sering belum tahu modal saat baru menambah produk.
  hargaJual   Decimal  @db.Decimal(12, 0)
  hargaBeli   Decimal? @db.Decimal(12, 0)
  // Boleh MINUS (keputusan produk: stok longgar). Hitungan fisik warung selalu
  // selisih; menolak jual gara-gara stok 0 di sistem hanya bikin kasir buntu.
  // Angka minus justru sinyal berguna "hitungan sistem ketinggalan".
  stok        Int      @default(0)
  satuan      String   @default("pcs")
  kategori    String?
  aktif       Boolean  @default(true)
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properti    Properti       @relation(fields: [propertiId], references: [id])
  item        ItemPenjualan[]
  itemMinumanKaraoke ItemMinumanKaraoke[]

  @@unique([propertiId, nama])
  @@index([propertiId, aktif, urutan])
}

// ───────────────────────────────────────────────
// KARAOKE — sewa ruang per jam (fasilitas hotel)
// ───────────────────────────────────────────────
// Jalur uang KETIGA, terpisah dari Sewa (per bulan) dan Penjualan (tanpa
// durasi). Ruang karaoke SENGAJA bukan `Kamar`: kamar hotel dihuni satu orang
// untuk rentang hari, ruang karaoke berganti orang tiap 1-2 jam. Menyatukan
// keduanya merusak papan jadwal hotel (`lib/jadwalKamar.ts` menganggap satu
// kamar satu penghuni pada satu rentang) dan membuat tamu yang sedang nyanyi
// terbaca sebagai tamu menginap.
model RuangKaraoke {
  id         String   @id @default(cuid())
  propertiId String
  nama       String            // "Reguler 1", "VIP 2"
  kapasitas  Int?
  aktif      Boolean  @default(true)
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  properti   Properti       @relation(fields: [propertiId], references: [id])
  tarif      TarifKaraoke[]
  sesi       SesiKaraoke[]

  @@unique([propertiId, nama])
  @@index([propertiId])
}

// Tarif per BLOK JAM. Satu ruang punya beberapa baris; misal 10:00-17:00,
// 17:00-24:00, 24:00-10:00. Wajib menutup 24 jam tanpa lubang & tanpa
// tumpang tindih — divalidasi di `lib/karaoke.ts` saat Pengaturan menyimpan.
//
// jamMulai/jamSelesai = MENIT SEJAK TENGAH MALAM (bukan DateTime): blok tarif
// berulang tiap hari dan tak punya tanggal. Menyimpannya sebagai DateTime
// memaksa memilih tanggal dummy yang harus diabaikan di setiap query — sumber
// bug klasik. `jamSelesai` boleh 1440 (= tengah malam) supaya blok terakhir
// tetap terwakili dan bisa menutup sampai 24:00.
model TarifKaraoke {
  id         String   @id @default(cuid())
  ruangId    String
  jamMulai   Int              // menit sejak 00:00, 0-1439
  jamSelesai Int              // menit sejak 00:00, 1-1440
  hargaPerJam Decimal @db.Decimal(12, 0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ruang      RuangKaraoke @relation(fields: [ruangId], references: [id], onDelete: Cascade)

  @@index([ruangId, jamMulai])
}

model SesiKaraoke {
  id             String        @id @default(cuid())
  propertiId     String
  ruangId        String
  nomor          String                  // "KR-0001" per properti
  namaPelanggan  String?                 // teks bebas — pelanggan umum sering tanpa KTP
  telepon        String?
  mulaiPada      DateTime
  rencanaSelesai DateTime
  selesaiAktual  DateTime?               // diisi saat sesi ditutup
  jumlahJam      Int                     // hasil pembulatan ke atas, DISALIN
  totalSewa      Decimal       @db.Decimal(12, 0)  // DISALIN, tak dihitung ulang
  jaminan        Decimal       @db.Decimal(12, 0) @default(0)
  status         StatusKaraoke @default(BERJALAN)
  // Piutang karaoke (pola "Bon Gantung" ZPos): sesi boleh ditutup sebelum
  // uang diterima. Default true = semua sesi lama dianggap sudah lunas,
  // karena sebelum kolom ini tak ada pilihan selain bayar di tempat.
  // Total piutang = totalSewa + minuman - jaminan (jaminan = uang muka).
  lunas          Boolean       @default(true)
  dibayarPada    DateTime?
  catatan        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  properti       Properti            @relation(fields: [propertiId], references: [id])
  ruang          RuangKaraoke        @relation(fields: [ruangId], references: [id])
  item           ItemSesiKaraoke[]
  minuman        ItemMinumanKaraoke[]

  @@unique([propertiId, nomor])
  @@index([ruangId, status])
  @@index([propertiId, status])
}

// Rincian satu jam sesi: tarif mana yang dipakai jam itu. Baris-baris inilah
// yang membuat tagihan bisa dipertanggungjawabkan saat pelanggan bertanya
// "kok mahal?" — kasir bisa menunjuk "jam 20:00 tarifnya beda", dan struk
// mencetaknya. Sekaligus membuat aturan "dipatok jam mulai jam itu" bisa
// diaudit pelanggan, bukan cuma dipercaya.
model ItemSesiKaraoke {
  id          String   @id @default(cuid())
  sesiId      String
  jamKe       Int                 // 1, 2, 3, ...
  mulai       DateTime
  selesai     DateTime
  hargaPerJam Decimal  @db.Decimal(12, 0)  // DISALIN dari tarif saat itu
  subtotal    Decimal  @db.Decimal(12, 0)

  sesi        SesiKaraoke @relation(fields: [sesiId], references: [id], onDelete: Cascade)

  @@unique([sesiId, jamKe])
}

// Minuman/makanan yang ditebus ke sesi. SENGAJA bukan model `Penjualan`:
// Penjualan adalah jalur uangnya sendiri (bisa ditarik ke kamar hotel). Minuman
// karaoke menempel ke sesi supaya pelanggan umum tak bisa kabur setelah pesan.
// Harga & nama DISALIN — struk lama tak berubah kalau harga produk naik.
model ItemMinumanKaraoke {
  id          String   @id @default(cuid())
  sesiId      String
  produkId    String
  namaProduk  String
  hargaSatuan Decimal  @db.Decimal(12, 0)
  jumlah      Int
  subtotal    Decimal  @db.Decimal(12, 0)

  sesi        SesiKaraoke @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  produk      Produk      @relation(fields: [produkId], references: [id])

  @@index([sesiId])
}

enum StatusKaraoke {
  BOOKING
  BERJALAN
  SELESAI
  BATAL
}

model Penjualan {
  id          String       @id @default(cuid())
  propertiId  String
  // NULL = jual lepas. Diisi = titipan ke kamar, BELUM_BAYAR sampai check-out.
  sewaId      String?
  // Nomor manusiawi per properti ("PJ-0007") — kasir & penyewa menyebutnya.
  nomor       String
  total       Decimal      @db.Decimal(12, 0)
  metodeBayar MetodeBayar  @default(TUNAI)
  status      StatusJual   @default(LUNAS)
  catatan     String?
  dibayarPada DateTime?
  createdAt   DateTime     @default(now())

  properti    Properti       @relation(fields: [propertiId], references: [id])
  sewa        Sewa?          @relation(fields: [sewaId], references: [id])
  item        ItemPenjualan[]

  @@unique([propertiId, nomor])
  @@index([propertiId, createdAt])
  @@index([sewaId, status])
}

model ItemPenjualan {
  id          String   @id @default(cuid())
  penjualanId String
  produkId    String
  // namaProduk/hargaSatuan/hargaBeli DISALIN saat transaksi, bukan dibaca lewat
  // relasi. Kalau produk nanti diubah harganya, diganti nama, atau di-nonaktifkan,
  // struk lama tetap menunjukkan angka yang benar-benar dibayar saat itu.
  namaProduk  String
  hargaSatuan Decimal  @db.Decimal(12, 0)
  hargaBeli   Decimal? @db.Decimal(12, 0)
  jumlah      Int
  subtotal    Decimal  @db.Decimal(12, 0)

  penjualan   Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)
  produk      Produk    @relation(fields: [produkId], references: [id])

  @@index([penjualanId])
  @@index([produkId])
}

enum StatusJual {
  LUNAS
  BELUM_BAYAR   // hanya dipakai kalau sewaId diisi (titipan kamar)
  BATAL
}
