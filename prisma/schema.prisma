// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// AUTH
// ───────────────────────────────────────────────
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role       @default(USER)
  faceId        String?    @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  properti      Properti[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  MANAGER
}

// ───────────────────────────────────────────────
// PROPERTI
// ───────────────────────────────────────────────
model Properti {
  id          String        @id @default(cuid())
  nama        String
  tipe        TipeProperti
  alamat      String
  kota        String
  provinsi    String        @default("Kalimantan Barat")
  deskripsi   String?
  fasilitas   String[]      @default([])
  aktif       Boolean       @default(true)
  // Jam acuan habis sewa (HH:mm, jam dinding lokal). Sewa HARIAN habis di jam
  // ini pada hari terakhir, bukan jam masuk + 24 jam — supaya checkout serempak.
  // ToleransiCheckout = menit kelonggaran sebelum ditandai lewat (120 = 2 jam).
  jamCheckout         String  @default("12:00")
  toleransiCheckout   Int     @default(120)
  // Kontak & catatan pemilik properti. Keduanya muncul di nota cetak:
  // noHp di baris kontak, teksNota menggantikan kalimat penutup bawaan.
  // Opsional — properti tanpa isinya tetap memakai teks bawaan.
  noHp        String?
  teksNota    String?
  isDemo      Boolean       @default(false)
  demoExpiresAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])

  kamar       Kamar[]
  tipeKamar   TipeKamar[]
}

enum TipeProperti {
  KOS
  KONTRAKAN
  HOTEL
  APARTEMEN
}

// ───────────────────────────────────────────────
// KAMAR
// ───────────────────────────────────────────────
model Kamar {
  id          String       @id @default(cuid())
  nomor       String
  lantai      Int          @default(1)
  luas        Float?       // m²
  fasilitas   String[]     @default([])
  foto        String[]     @default([])
  status      StatusKamar  @default(TERSEDIA)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Tipe kamar kini master data (model TipeKamar), bukan enum — pemilik bisa
  // menambah tipe sendiri (Studio, Family, ...). WAJIB diisi: harga sewa
  // melekat pada tipe (lihat HargaTipe), jadi kamar tanpa tipe tak bisa
  // dihargai. Baris lama yang null ditautkan ke tipe bawaan saat deploy
  // (lihat scripts/rapikan-tipe-kamar.mjs di start command).
  tipeId      String
  tipe        TipeKamar    @relation(fields: [tipeId], references: [id])

  propertiId  String
  properti    Properti     @relation(fields: [propertiId], references: [id])

  sewa        Sewa[]

  @@unique([propertiId, nomor])
  @@index([tipeId])
}

// Tipe kamar per properti. Fasilitas di sini adalah BAWAAN tipe — kamar yang
// belum diisi fasilitas sendiri mewarisinya. Kamar yang sudah punya fasilitas
// sendiri TIDAK ditimpa, supaya kamar yang berbeda dari tipe-nya tetap aman.
// Harga juga melekat di sini (lihat HargaTipe) — satu tipe, satu daftar harga.
model TipeKamar {
  id          String    @id @default(cuid())
  nama        String
  keterangan  String?
  fasilitas   String[]  @default([])
  urutan      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  propertiId  String
  properti    Properti  @relation(fields: [propertiId], references: [id])

  kamar       Kamar[]
  harga       HargaTipe[]

  @@unique([propertiId, nama])
  @@index([propertiId])
}

enum StatusKamar {
  TERSEDIA
  TERISI
  PEMELIHARAAN
  DIPESAN
}

// Harga sewa melekat pada TIPE kamar, bukan per kamar: mengubah tarif Standar
// cukup satu tempat, bukan 12 kamar satu per satu. Persis pola fasilitas.
model HargaTipe {
  id          String      @id @default(cuid())
  tipeKamarId String
  periodeSewa PeriodeSewa
  harga       Decimal     @db.Decimal(12, 0)
  deposit     Decimal?    @db.Decimal(12, 0)
  aktif       Boolean     @default(true)

  tipeKamar   TipeKamar   @relation(fields: [tipeKamarId], references: [id], onDelete: Cascade)

  @@unique([tipeKamarId, periodeSewa])
  @@index([tipeKamarId])
}

enum PeriodeSewa {
  HARIAN
  MINGGUAN
  BULANAN
  TAHUNAN
}

// ───────────────────────────────────────────────
// PENYEWA
// ───────────────────────────────────────────────
model Penyewa {
  id           String     @id @default(cuid())
  nama         String?
  nik          String?    @unique
  noHp         String?
  email        String?
  pekerjaan    String?
  alamatAsal   String?
  fotoKtp      String?
  tipeEntitas  TipeEntitas @default(INDIVIDU)
  namaPerusahaan String?
  npwp         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sewa         Sewa[]
}

enum TipeEntitas {
  INDIVIDU
  PERUSAHAAN
}

// ───────────────────────────────────────────────
// SEWA (kontrak)
// ───────────────────────────────────────────────
model Sewa {
  id           String      @id @default(cuid())
  kamarId      String
  penyewaId    String
  periodeSewa  PeriodeSewa
  tanggalMasuk DateTime
  tanggalKeluar DateTime
  // Diisi saat check-out. Bisa beda dari tanggalKeluar (kontrak) kalau penyewa
  // keluar lebih cepat/lambat — tanpa ini laporan "kamar kosong sejak kapan"
  // ikut tanggal kontrak dan jadi tidak akurat.
  tanggalKeluarAktual DateTime?
  hargaSewa    Decimal     @db.Decimal(12, 0)
  deposit      Decimal     @db.Decimal(12, 0) @default(0)
  statusSewa   StatusSewa  @default(AKTIF)
  metodeBayar  MetodeBayar @default(TUNAI)
  catatan      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  kamar        Kamar       @relation(fields: [kamarId], references: [id])
  penyewa      Penyewa     @relation(fields: [penyewaId], references: [id])
  tagihan      Tagihan[]
}

enum StatusSewa {
  AKTIF
  SELESAI
  DIBATALKAN
  PENDING
}


// ───────────────────────────────────────────────
// TAGIHAN & PEMBAYARAN
// ───────────────────────────────────────────────
model Tagihan {
  id           String         @id @default(cuid())
  sewaId       String
  nominal      Decimal        @db.Decimal(12, 0)
  periodeDari  DateTime
  periodeHingga DateTime
  jatuhTempo   DateTime
  status       StatusTagihan  @default(BELUM_BAYAR)
  catatan      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sewa         Sewa           @relation(fields: [sewaId], references: [id])
  pembayaran   Pembayaran[]
}

enum StatusTagihan {
  BELUM_BAYAR
  SEBAGIAN
  LUNAS
  TERLAMBAT
  DIBATALKAN
}

model Pembayaran {
  id            String        @id @default(cuid())
  tagihanId     String
  nominal       Decimal       @db.Decimal(12, 0)
  metodeBayar   MetodeBayar
  buktiTransfer String?
  catatan       String?
  dibayarPada   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  tagihan       Tagihan       @relation(fields: [tagihanId], references: [id])
}

enum MetodeBayar {
  TUNAI
  TRANSFER
  QRIS
  VA_BCA
  VA_BRI
  VA_MANDIRI
  LAINNYA
}

// ───────────────────────────────────────────────
// PENGELUARAN
// ───────────────────────────────────────────────
model Pengeluaran {
  id          String           @id @default(cuid())
  propertiId  String
  kategori    KategoriBeban
  deskripsi   String
  nominal     Decimal          @db.Decimal(12, 0)
  tanggal     DateTime
  bukti       String?
  createdAt   DateTime         @default(now())

  @@index([propertiId, tanggal])
}

enum KategoriBeban {
  LISTRIK
  AIR
  INTERNET
  KEBERSIHAN
  PERAWATAN
  PAJAK
  GAJI
  LAINNYA
}

// ───────────────────────────────────────────────
// NOTIFIKASI
// ───────────────────────────────────────────────
model Notifikasi {
  id          String           @id @default(cuid())
  propertiId  String
  tipe        TipeNotifikasi
  judul       String
  pesan       String
  dibaca      Boolean          @default(false)
  referensiId String?          // bisa sewaId, tagihanId, dll
  createdAt   DateTime         @default(now())

  @@index([propertiId, dibaca])
}

enum TipeNotifikasi {
  TAGIHAN_JATUH_TEMPO
  TAGIHAN_TERLAMBAT
  PEMBAYARAN_DITERIMA
  CHECKIN_BARU
  CHECKOUT_BESOK
  BOOKING_BARU
  PEMELIHARAAN
  INFO
}
